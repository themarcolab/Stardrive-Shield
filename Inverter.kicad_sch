	(text "DT/Mode if set to GND sets 6PWM mode.\nRdt sets the dead-time (dt) in 3PWM mode.\n\nRdt[kOhm] = 96.15 * dt[uS] - 4.45\ndt[uS] = (Rdt[kOhm] + 4.45)/96.15\n50kOhm -> ~50uS"
		(exclude_from_sim no)
		(at 148.844 28.194 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f3f346f8-2428-493b-abaf-4c56c16a3036")
	)
	(text "SCREF set the treshold for Vds protection. Disabled if SCREF > 2.9V\n"
